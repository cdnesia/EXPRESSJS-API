# Server
PORT=3000
NODE_ENV=development

# Database (MySQL) — main app database, managed by Prisma
DATABASE_URL="mysql://root:rootroot@localhost:3306/restfull_spi_expressjs"
DATABASE_URL_PAYMENT="mysql://root:rootroot@localhost:3306/dev_payment"
DATABASE_URL_SIADE="mysql://root:rootroot@localhost:3306/dev_siade_new"
DATABASE_URL_SIMAKU="mysql://root:rootroot@localhost:3306/dev_simkeu_new"
DATABASE_URL_SIADE_OLD="mysql://user:password@host:port/umja"

# JWT
JWT_ACCESS_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=2m
JWT_REFRESH_EXPIRES_IN=30d

# CORS — comma-separated list of allowed origins (this API is consumed by multiple clients)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Telegram bot — used by POST /api/v1/telegram/send-message
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_API_URL=https://api.telegram.org
